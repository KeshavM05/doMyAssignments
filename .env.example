# ── D2L / OnQ Brightspace ─────────────────────────────────────────────────────
ONQ_BASE_URL=https://onq.queensu.ca
D2L_CLIENT_ID=your_oauth2_client_id_here
D2L_CLIENT_SECRET=your_oauth2_client_secret_here
D2L_REDIRECT_URI=http://localhost:8080/callback

# Token storage path (relative to project root)
TOKEN_FILE=.tokens.json

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose one: openai | anthropic | google | local
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-5

GOOGLE_API_KEY=...
GOOGLE_MODEL=gemini-2.5-pro

# ── Pipeline Settings ─────────────────────────────────────────────────────────
# How often to poll for new assignments (seconds)
POLL_INTERVAL_SECONDS=300

# Assignment types to skip auto-completion (comma-separated)
SKIP_TYPES=quiz,exam

# Output directory for generated answers
OUTPUT_DIR=outputs/

# Auto-submit after LLM completes? (true/false — keep false until tested!)
AUTO_SUBMIT=false
