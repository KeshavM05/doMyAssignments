# ── Authentication ────────────────────────────────────────────────────────────
# This project uses cookie-based auth (NOT OAuth).
# On first run, a Playwright browser window opens for you to log in manually.
# Your session cookies are saved to SESSION_FILE and reused on subsequent runs.
# No D2L OAuth app registration is required.

# ── D2L / OnQ Brightspace ─────────────────────────────────────────────────────
ONQ_BASE_URL=https://onq.queensu.ca

# ── Session storage ───────────────────────────────────────────────────────────
# Path where browser cookies are saved after your manual SSO login
# This file is gitignored — never commit it
SESSION_FILE=.session_state.json

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose one: openai | anthropic | google
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-5

GOOGLE_API_KEY=...
GOOGLE_MODEL=gemini-2.5-pro

# ── Pipeline Settings ─────────────────────────────────────────────────────────
# How often to poll for new assignments (seconds)
POLL_INTERVAL_SECONDS=300

# Assignment name keywords to skip (comma-separated, case-insensitive)
SKIP_TYPES=quiz,exam,midterm,final

# Output directory for generated answers
OUTPUT_DIR=outputs/

# Auto-submit after LLM completes? (true/false — keep false until you've tested!)
AUTO_SUBMIT=false
